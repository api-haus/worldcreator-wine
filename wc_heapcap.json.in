{
  "file_format_version": "1.2.0",
  "layer": {
    "name": "VK_LAYER_WC_heapcap",
    "type": "GLOBAL",
    "library_path": "@LIB@",
    "api_version": "1.3.0",
    "implementation_version": "1",
    "description": "Cap host-visible/device-local Vulkan heap sizes for World Creator",
    "functions": {
      "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion",
      "vkGetInstanceProcAddr": "VK_LAYER_WC_heapcap_GetInstanceProcAddr"
    },
    "enable_environment": { "WC_HEAPCAP_ENABLE": "1" },
    "disable_environment": { "WC_HEAPCAP_DISABLE": "1" }
  }
}
