#!/usr/bin/env bash
# Generic World Creator launcher. Resolves the install dir, sets the runtime + GPU
# denoise env, and applies the startup-runaway guard automatically (every version
# except 2025.1 can run away — see README). Works for any version installed by
# ./install-wc.sh.
#
#   ./wc "World Creator 2026.4"              # GPU denoise + runaway guard
#   ./wc "World Creator 2026.4" --no-denoise # baseline, no denoiser
#   ./wc /abs/path/to/portable              # absolute dir also accepted
#
# Env knobs: WC_MAX_TRIES, WC_GUARD_WINDOW_S, WC_KILL_RSS_MB, WC_KILL_FLOOR_MB,
# WC_GUARD=0|1 (force the guard off/on).
set -u
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

PREFIX="$HERE/wineprefix"; DENOISE=1; NAME=""
while [ $# -gt 0 ]; do case "$1" in
  --no-denoise) DENOISE=0; shift;;
  --prefix) PREFIX="$2"; shift 2;;
  -h|--help) sed -n '2,12p' "$0"; exit 0;;
  --*) echo "unknown option: $1" >&2; exit 2;;
  *) NAME="$1"; shift;;
esac; done
[ -n "$NAME" ] || { echo "usage: wc <name|dir> [--no-denoise] [--prefix DIR]" >&2; exit 2; }

case "$NAME" in /*) APP="$NAME";; *) APP="$PREFIX/drive_c/Program Files/$NAME";; esac
[ -x "$APP/WorldCreator.exe" ] || { echo "error: WorldCreator.exe not found at: $APP" >&2; exit 2; }

export WINEPREFIX="$PREFIX" WINEDEBUG=-all EGL_LOG_LEVEL=fatal DOTNET_EnableWriteXorExecute=0
# Explicit in-prefix runtime: overrides any host DOTNET_ROOT leak (which mis-resolves
# to Z:\usr\share\dotnet) and skips the wine-flaky apphost registry probe.
export DOTNET_ROOT='C:\Program Files\dotnet'
if [ "$DENOISE" = 1 ]; then
  export WINEDLLOVERRIDES="nvcuda=b" WINEDLLPATH="$HERE/nvlibs-build/lib/wine"
fi

# 2025.1 is the only version that never runs away; everything else (2025.2+, 2026.x)
# may. Default the guard from the version name; WC_GUARD overrides.
case "$NAME" in *2025.1*|*2025_1*) GUARD_DEFAULT=0;; *) GUARD_DEFAULT=1;; esac
GUARD="${WC_GUARD:-$GUARD_DEFAULT}"

cd "$APP" || exit 1

if [ "$GUARD" != 1 ]; then
  exec wine WorldCreator.exe "$@"
fi

# --- startup-runaway guard: relaunch until a boot survives the window, then hold it ---
KILL_RSS_MB="${WC_KILL_RSS_MB:-5000}"      # clean boots peak <4GB; a runaway blows past in <1s
FLOOR_MB="${WC_KILL_FLOOR_MB:-12000}"      # also bail if host MemAvailable drops this low
GUARD_WINDOW_S="${WC_GUARD_WINDOW_S:-25}"  # runaway fires ~11s; surviving 25s = clean
MAX_TRIES="${WC_MAX_TRIES:-30}"            # ~1-in-10 clean rate: 10 tries ~65%, 30 ~96%
LOG="$HERE/$(basename "$0")-$(echo "$NAME" | tr -c 'A-Za-z0-9.' _).log"

# wineserver -k gracefully terminates the whole session for THIS prefix and -w waits;
# scoped to WINEPREFIX, so it never touches another prefix.
kill_session() { wineserver -k 2>/dev/null; wineserver -w 2>/dev/null; }
trap kill_session EXIT
trap 'exit 130' INT TERM

try=0
while [ "$try" -lt "$MAX_TRIES" ]; do
  try=$((try + 1))
  ( exec wine WorldCreator.exe "$@" ) > "$LOG" 2>&1 &
  wpid=$!
  appeared=0; elapsed_ms=0; verdict="running"; rss=0
  while :; do
    sleep 0.3
    pids=$(pgrep -f 'WorldCreator.exe')
    if [ -z "$pids" ]; then
      if [ "$appeared" = 1 ]; then verdict="exited"; break; fi
      kill -0 "$wpid" 2>/dev/null || { verdict="exited"; break; }
      continue
    fi
    appeared=1; elapsed_ms=$((elapsed_ms + 300)); rss=0
    for p in $pids; do
      v=$(awk '/^VmRSS:/{print $2}' "/proc/$p/status" 2>/dev/null)
      [ -n "$v" ] && rss=$((rss + v / 1024))
    done
    avail=$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo)
    if [ "$rss" -gt "$KILL_RSS_MB" ] || [ "$avail" -lt "$FLOOR_MB" ]; then verdict="runaway"; break; fi
    [ "$elapsed_ms" -ge "$((GUARD_WINDOW_S * 1000))" ] && { verdict="clean"; break; }
  done

  if [ "$verdict" = "clean" ]; then
    echo "[wc] clean boot (try $try) — running." >&2
    wait "$wpid"; exit $?
  fi
  echo "[wc] startup $verdict (try $try, RSS=${rss}MB) — killed; relaunching." >&2
  [ -n "${pids:-}" ] && kill -9 $pids 2>/dev/null
  kill "$wpid" 2>/dev/null
  kill_session
done
echo "[wc] no clean boot in $MAX_TRIES tries — rerun." >&2
exit 1
