#!/usr/bin/env bash
# Generic World Creator launcher. Resolves the install dir, sets the runtime + GPU
# denoise environment for versions installed by ./install-wc.sh.
# Requires Wine 11.17+ or the TTC header fix backported (see README).
#
#   ./wc "World Creator 2026.4"              # GPU denoise
#   ./wc "World Creator 2026.4" --no-denoise # baseline, no denoiser
#   ./wc /abs/path/to/portable              # absolute dir also accepted
#
set -u
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

PREFIX="$HERE/wineprefix"; DENOISE=1; NAME=""
while [ $# -gt 0 ]; do case "$1" in
  --no-denoise) DENOISE=0; shift;;
  --prefix) PREFIX="$2"; shift 2;;
  -h|--help) sed -n '2,9p' "$0"; exit 0;;
  --*) echo "unknown option: $1" >&2; exit 2;;
  *) NAME="$1"; shift;;
esac; done
[ -n "$NAME" ] || { echo "usage: wc <name|dir> [--no-denoise] [--prefix DIR]" >&2; exit 2; }

case "$NAME" in /*) APP="$NAME";; *) APP="$PREFIX/drive_c/Program Files/$NAME";; esac
[ -x "$APP/WorldCreator.exe" ] || { echo "error: WorldCreator.exe not found at: $APP" >&2; exit 2; }

export WINEPREFIX="$PREFIX" WINEDEBUG="${WINEDEBUG:--all}" EGL_LOG_LEVEL=fatal DOTNET_EnableWriteXorExecute=0
# Explicit in-prefix runtime: overrides any host DOTNET_ROOT leak (which mis-resolves
# to Z:\usr\share\dotnet) and skips the wine-flaky apphost registry probe.
export DOTNET_ROOT='C:\Program Files\dotnet'
if [ "$DENOISE" = 1 ]; then
  export WINEDLLOVERRIDES="nvcuda=b" WINEDLLPATH="$HERE/nvlibs-build/lib/wine"
  # The bridge dlopens libcuda.so.1 by soname. Distros that keep the driver off
  # the default loader path (NixOS: /run/opengl-driver/lib, and no ld.so.conf)
  # make that fail, and the only trace is one line — "Wine cannot find the cuda
  # library, CUDA support is disabled" — behind WINEDEBUG=+nvcuda; the denoise
  # toggle turns on and does nothing.
  [ -d /run/opengl-driver/lib ] &&
    export LD_LIBRARY_PATH="/run/opengl-driver/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

cd "$APP" || exit 1
LOG="$HERE/wc-$(basename "$APP" | tr -c 'A-Za-z0-9.' _).log"
exec wine WorldCreator.exe "$@" >"$LOG" 2>&1
